# revialife.com
#
# This site has no database. `next build` must succeed with none of these set —
# that is the gate the remodel is held to, and every value below changes what a
# page can do rather than whether it renders.

# ── The research provider ───────────────────────────────────────────────────
# Where compound availability is read from, and where every buy control points.
# src/lib/partner.ts is the only place this is read; an unreachable origin makes
# the availability control render nothing rather than claim "not stocked".
NEXT_PUBLIC_I2B_ORIGIN=https://i2bhealth.vercel.app

# This site's own origin. Used in unsubscribe links and canonical URLs.
NEXT_PUBLIC_URL=https://revialife.com

# ── Mail ────────────────────────────────────────────────────────────────────
# Required in production. Contact, partnership and funnel-lead submissions are
# delivered by mail and NOTHING else records them, so an unset key in
# production makes those routes refuse the submission rather than swallow it.
RESEND_API_KEY=

# Where form submissions land. Defaults to contact@revialife.com.
ADMIN_EMAIL=

# The newsletter list. Optional: unset falls back to mailing each sign-up to
# ADMIN_EMAIL, which is durable but not a list.
RESEND_AUDIENCE_ID=

# Signs unsubscribe links so a link can only remove the address it was issued
# for. Falls back to RESEND_API_KEY; set this if you rotate that key and want
# links in already-sent mail to keep working.
UNSUBSCRIBE_SECRET=

# ── The assistant ───────────────────────────────────────────────────────────
# Unset disables /api/chat. The widget degrades to its deflection message.
# Note the casing — this is the variable name the code reads, verbatim.
OpenAi_chatbot_Key=

# ── Bot protection on public forms ──────────────────────────────────────────
# Both or neither. Unset skips verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
